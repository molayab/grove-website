---
import { ui } from '../i18n';
import type { Lang } from '../data/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].footer;
const BLOG = 'https://molayab.com/blog/#tag=grove';
// Guides are translated; the legal pages are English-only (see AGENTS.md).
const guide = (file: string) => (lang === 'es' ? `/es/${file}` : `/${file}`);
---

<footer>
  <div class="footer-inner">
    <span class="logo">Grove for Mac</span>
    <div class="footer-links">
      <a href="mailto:hello@molayab.com">{t.support}</a>
      <a href={BLOG} hreflang="en">{t.blog}</a>
      <a href="/privacy-policy.html">{t.privacy}</a>
      <a href="/refund-policy.html">{t.refund}</a>
      <a href={guide('git-worktree-app-mac.html')}>{t.worktrees}</a>
      <a href={guide('claude-code-mac-app.html')}>{t.claudeCode}</a>
      <a href={guide('ai-coding-agents-mac-app.html')}>{t.agents}</a>
      <a href="#" id="cookie-settings-link">{t.cookies}</a>
      <div class="theme-switch" role="group" aria-label={t.theme.label} hidden data-theme-toggle>
        <button type="button" class="theme-switch__option" data-theme-choice="system" aria-pressed="true" aria-label={t.theme.system} title={t.theme.system}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        </button>
        <button type="button" class="theme-switch__option" data-theme-choice="light" aria-pressed="false" aria-label={t.theme.light} title={t.theme.light}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button type="button" class="theme-switch__option" data-theme-choice="dark" aria-pressed="false" aria-label={t.theme.dark} title={t.theme.dark}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </div>
    <span class="footer-copy">© 2026 <a href="https://molayab.com">Mateo Olaya Bernal</a></span>
  </div>
</footer>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle.js';
  initThemeToggle();
</script>

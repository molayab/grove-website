---
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Grove for Mac",
  "alternateName": "Grove",
  "url": "https://grove.molayab.com/",
  "description": "The native Mac app for Claude Code, Codex and other AI coding agents. Switch git worktree and your agent, shell and diff follow. $9.99, pay once.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "macOS 26 or later",
  "inLanguage": "en",
  "image": "https://grove.molayab.com/og-image.png",
  "screenshot": "https://grove.molayab.com/screenshots/agent.png",
  "downloadUrl": "https://github.com/molayab/grove-website/releases/latest/download/Grove.dmg",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "9.99",
    "highPrice": "39.99",
    "offerCount": "3"
  },
  "author": {
    "@type": "Person",
    "name": "Mateo Olaya Bernal",
    "url": "https://molayab.com"
  }
};
---

<Base
  lang="en"
  title="Grove for Mac — the native app for AI coding agents & git worktrees"
  description="The native Mac app for Claude Code, Codex and other AI coding agents. Switch git worktree and your agent, shell and diff follow. $9.99, pay once."
  path="/"
  navVariant="home"
  ogImageAlt="Grove for Mac: AI coding agents and git worktrees in one native macOS window"
  jsonLd={jsonLd}
>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-badge">No Electron &nbsp;·&nbsp; No Subscription &nbsp;·&nbsp; Native macOS</div>
    <h1>Your dev workspace,<br>one window.</h1>
    <p class="hero-sub">
      The native Mac app for AI coding agents. Switch worktree, and your agent, shell, and diff follow — Claude Code, Codex, Gemini CLI and more.
    </p>
    <div class="hero-cta">
      <a href="#download" role="button" class="btn btn-primary btn-large">Start free trial</a>
      <a href="#features" role="button" class="btn btn-ghost btn-large">See what's inside</a>
    </div>
    <p class="hero-trial">Free trial &nbsp;·&nbsp; Developer ID signed &amp; notarized by Apple</p>
  </div>

  <!-- Hero: auto-advancing carousel of app screenshots -->
  <div class="window-wrap">
    <div class="hero-shot" id="hero-carousel" role="region" aria-roledescription="carousel" aria-label="Grove screenshots">
      <div class="hero-slides">
        <img class="hero-slide is-active" src="/screenshots/palette.png" width="1800" height="1125"
             alt="Grove's window with the ⌘K palette open over a Claude Code session, listing saved prompts and shell commands for the workspace" loading="eager" decoding="async" />
        <img class="hero-slide" src="/screenshots/agent.png" width="1800" height="1125"
             alt="Grove's Agent tab running Claude Code in a project workspace, with the workspace list, worktrees, and git panel in the sidebar" loading="lazy" decoding="async" aria-hidden="true" />
        <img class="hero-slide" src="/screenshots/changes-review.png" width="1800" height="1125"
             alt="Grove's Changes tab showing a unified diff with an inline comment box and a Send to Agent button" loading="lazy" decoding="async" aria-hidden="true" />
        <img class="hero-slide" src="/screenshots/files-markdown.png" width="1800" height="1125"
             alt="Grove's Files tab with a project file tree and a rendered Markdown README, including a Mermaid diagram" loading="lazy" decoding="async" aria-hidden="true" />
        <img class="hero-slide" src="/screenshots/shell.png" width="1800" height="1125"
             alt="Grove's Shell tab with two shell tabs open, showing git log and worktree output" loading="lazy" decoding="async" aria-hidden="true" />
        <img class="hero-slide" src="/screenshots/browser.png" width="1800" height="1125"
             alt="Grove's Browser tab with pinned Vite and React documentation sites open as tabs" loading="lazy" decoding="async" aria-hidden="true" />
      </div>
    </div>
    <div class="hero-controls" role="group" aria-label="Choose a screenshot">
      <button type="button" class="hero-dot" aria-label="Saved prompts &amp; commands, one ⌘K away" aria-current="true"></button>
      <button type="button" class="hero-dot" aria-label="Your AI agent, already in the right folder" aria-current="false"></button>
      <button type="button" class="hero-dot" aria-label="Review the diff and send notes to the agent" aria-current="false"></button>
      <button type="button" class="hero-dot" aria-label="File tree with live Markdown previews" aria-current="false"></button>
      <button type="button" class="hero-dot" aria-label="As many shell tabs as you need" aria-current="false"></button>
      <button type="button" class="hero-dot" aria-label="Your project's pages, pinned beside the code" aria-current="false"></button>
      <button type="button" class="hero-pause" id="hero-pause" aria-label="Pause slideshow"
              data-label-pause="Pause slideshow" data-label-play="Play slideshow"><svg class="hero-icon-pause" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2" y="1.5" width="3" height="9" rx="0.75"/><rect x="7" y="1.5" width="3" height="9" rx="0.75"/></svg><svg class="hero-icon-play" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" hidden><path d="M3 1.8v8.4a.6.6 0 0 0 .9.5l6.6-4.2a.6.6 0 0 0 0-1L3.9 1.3a.6.6 0 0 0-.9.5z"/></svg></button>
    </div>
    <p class="hero-caption" id="hero-caption">Saved prompts &amp; commands, one ⌘K away</p>
  </div>
</section>

<!-- DOWNLOAD -->
<section class="section download" id="download">
  <div class="section-inner">
    <p class="eyebrow">Download</p>
    <h2>Try Grove, free.</h2>
    <p class="section-sub">A fully-featured trial build, served straight from the latest GitHub release — no account, no email required.</p>

    <article class="download-card">
      <a id="download-btn" role="button" class="btn btn-primary btn-large download-btn"
         href="https://github.com/molayab/grove-website/releases/latest/download/Grove.dmg">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 3v10M6 9l4 4 4-4M4 16h12"/>
        </svg>
        Download for macOS
      </a>
      <p class="download-meta" id="download-meta">Fetching the latest release&hellip;</p>
      <p class="download-note">Signed &amp; notarized by Apple — just open it, no security warnings.</p>
      <a id="download-all-releases" class="download-alt-link"
         href="https://github.com/molayab/grove-website/releases">All releases on GitHub →</a>
    </article>
  </div>
</section>

<!-- DEMO -->
<section class="section demo" id="demo">
  <div class="section-inner">
    <p class="eyebrow">Demo</p>
    <h2>See it in motion.</h2>
    <p class="section-sub">Switch worktrees and your agent, shell and diff follow — then the 25-second tour.</p>

    <div class="demo-grid">
      <figure class="demo-item">
        <video class="demo-video demo-video-worktrees" src="/screenshots/grove-worktrees.mp4" width="1920" height="1264"
               autoplay muted loop playsinline preload="metadata" aria-label="Screen recording of Grove switching between git worktrees while the agent, shell, files and changes follow"></video>
        <figcaption class="screenshot-caption">Switch worktrees: the agent, shell, files and changes follow.</figcaption>
      </figure>
      <figure class="demo-item">
        <video class="demo-video demo-video-promo" src="/screenshots/grove-promo-youtube.mp4" width="1920" height="1080"
               controls playsinline preload="none" poster="/screenshots/agent.png" aria-label="Grove promo video: AI coding agents, git worktrees, diff review and saved prompts in one native Mac window"></video>
        <figcaption class="screenshot-caption">Grove in 25 seconds.</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="section features" id="features">
  <div class="section-inner">
    <p class="eyebrow">Features</p>
    <h2>Everything a modern developer needs.</h2>
    <p class="section-sub">No Electron. No subscriptions. Just a fast, focused native app.</p>

    <div class="feature-grid">

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="8" width="28" height="20" rx="3"/>
          <path d="M12 16l4 4-4 4M19 24h5"/>
        </svg>
        <h3>AI Agents, natively</h3>
        <p>Bring your own AI coding agent — Claude Code, opencode, Codex, Gemini CLI, Aider, or any other CLI you add yourself — and it just works, already pointed at the right folder. Run several agent tabs side by side, no PATH to configure.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="10" r="3.5"/><circle cx="9" cy="26" r="3.5"/><circle cx="27" cy="26" r="3.5"/>
          <path d="M18 13.5V20M18 20l-6.5 3M18 20l6.5 3"/>
        </svg>
        <h3>Worktree-first</h3>
        <p>Work on three branches at once, without losing your place. Start a new worktree from any branch in a click — each one gets its own agent, shell, files, and changes, and everything follows when you switch.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 10h18M9 16h18M9 22h10"/>
          <path d="M25 21l2.5 2.5L25 26"/>
          <path d="M19 23.5h8.5"/>
        </svg>
        <h3>Review, then hand it back</h3>
        <p>The Changes tab updates live as your agent edits files. Read the diff, comment on any line, and send that note straight to the agent — no copy-pasting file paths and line numbers.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="7" width="24" height="22" rx="3"/>
          <path d="M11 14h14M11 19h9"/>
          <path d="M22 24h4"/>
        </svg>
        <h3>Prompts &amp; commands, ⌘K away</h3>
        <p>Save the prompts and commands you reach for every day, per project or in a shared library. Press ⌘K, pick one, and it lands in your agent or a shell tab — ready to run.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 12h20M8 18h14M8 24h10"/>
          <circle cx="27" cy="24" r="4.5"/>
          <path d="M25 24l1.5 1.5L29 22"/>
        </svg>
        <h3>Git, in plain English</h3>
        <p>One Sync button instead of fetch, pull, and push. Save your changes, see your recent saves — jump to any of them as a new worktree — and if a pull is blocked by local edits, Grove offers to stash and pull for you.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 6h14l6 6v18H8z"/><path d="M22 6v6h6"/>
          <path d="M12 20h7M12 24h5"/>
        </svg>
        <h3>Files, with real previews</h3>
        <p>Browse the checkout in a file tree and preview what you click. Markdown renders GitHub-style — tables, code, even Mermaid diagrams — and exports to PDF in one step.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="8" width="28" height="20" rx="3"/>
          <path d="M10 18l3 3-3 3M16 21h10"/>
        </svg>
        <h3>Shell tabs</h3>
        <p>Need a real terminal? Open as many as you like, all rooted in the same folder as your agent — run the tests in one, tail a log in another, no context switch.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="18" r="13"/>
          <path d="M5 18h26M18 5c3.5 3.6 5 8 5 13s-1.5 9.4-5 13c-3.5-3.6-5-8-5-13s1.5-9.4 5-13z"/>
        </svg>
        <h3>Your project's web pages, pinned</h3>
        <p>Pin the issue tracker, docs, or dashboard that goes with each project. They open in the Browser tab, right next to your code, and stay with that workspace.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 4l14 8v12l-14 8L4 24V12z"/>
          <path d="M18 4v28M4 12l14 8 14-8"/>
        </svg>
        <h3>No destructive defaults</h3>
        <p>Grove won't let a stray click wipe your work. There's no force push, discarding a file or dropping an unpushed commit always asks first, and anything that reaches beyond your machine asks too.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="7" width="28" height="22" rx="3"/>
          <path d="M18 7v22M18 18h14"/>
        </svg>
        <h3>Split layouts</h3>
        <p>Put two or three spaces side by side — Agent beside Changes, Shell beside Files. Pick a layout from the toolbar or ⌃⌘1–6, and move between panes from the keyboard.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 5l3.9 7.9 8.6 1.3-6.2 6 1.5 8.6L18 24.8l-7.8 4 1.5-8.6-6.2-6 8.6-1.3z"/>
        </svg>
        <h3>Worktrees, organized</h3>
        <p>Star the worktrees you live in, collect the rest into named groups, reorder them and add a one-line description. Lock one so it stays put, or archive it when the branch is done.</p>
      </article>

      <article class="feature-card">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="7" y="5" width="22" height="26" rx="3"/>
          <path d="M12 13l2 2 3.5-3.5M20 14h5M12 22l2 2 3.5-3.5M20 23h5"/>
        </svg>
        <h3>Notes that follow the checkout</h3>
        <p>Each worktree gets its own “Working on” line, an ordered TODO list and a scratch note — and open TODOs show right on its row in the sidebar, so you know where you left off.</p>
      </article>

      <article class="feature-card feature-highlight">
        <svg class="feature-icon" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="18" r="14"/>
          <path d="M18 10v8l6 4"/>
        </svg>
        <div>
          <h3>Keeps working while you don't</h3>
          <p>Switch to another project and this one keeps going — its agent and shell run on in the background even when you're not looking. Check in on one thing without pausing another, and come back to exactly the tab you left.</p>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- SCREENSHOTS -->
<section class="section screenshots" id="screenshots">
  <div class="section-inner">
    <p class="eyebrow">Screenshots</p>
    <h2>See it in the window.</h2>
    <p class="section-sub">The same checkout, every way you work on it.</p>

    <div class="screenshot-gallery">
      <div class="screenshot-item">
        <a class="screenshot-frame" href="/screenshots/agent.png">
          <img src="/screenshots/agent.png" width="1800" height="1125" loading="lazy"
               alt="Grove's Agent tab running Claude Code in a project workspace, with the workspace list, worktrees, and git panel in the sidebar" />
        </a>
        <p class="screenshot-caption">Your agent of choice, already in the right folder — with every project and worktree one click away.</p>
      </div>
      <div class="screenshot-item">
        <a class="screenshot-frame" href="/screenshots/changes-review.png">
          <img src="/screenshots/changes-review.png" width="1800" height="1125" loading="lazy"
               alt="Grove's Changes tab showing a unified diff of a React component, with an inline comment box and a Send to Agent button" />
        </a>
        <p class="screenshot-caption">Review the diff, comment on a line, and send it straight to your agent.</p>
      </div>
      <div class="screenshot-item">
        <a class="screenshot-frame" href="/screenshots/palette.png">
          <img src="/screenshots/palette.png" width="1800" height="1125" loading="lazy"
               alt="Grove's ⌘K palette listing saved prompts and shell commands for the workspace" />
        </a>
        <p class="screenshot-caption">Press ⌘K to run a saved prompt or command against the current checkout.</p>
      </div>
      <div class="screenshot-item">
        <a class="screenshot-frame" href="/screenshots/files-markdown.png">
          <img src="/screenshots/files-markdown.png" width="1800" height="1125" loading="lazy"
               alt="Grove's Files tab with a project file tree and a rendered Markdown README, including a Mermaid architecture diagram and a table" />
        </a>
        <p class="screenshot-caption">A file tree with live previews — Markdown renders with tables and Mermaid diagrams.</p>
      </div>
      <div class="screenshot-item">
        <a class="screenshot-frame" href="/screenshots/shell.png">
          <img src="/screenshots/shell.png" width="1800" height="1125" loading="lazy"
               alt="Grove's Shell tab with two shell tabs open, showing git log and worktree output for the workspace" />
        </a>
        <p class="screenshot-caption">As many login shells as you need, rooted at the same checkout as your agent.</p>
      </div>
      <div class="screenshot-item">
        <a class="screenshot-frame" href="/screenshots/browser.png">
          <img src="/screenshots/browser.png" width="1800" height="1125" loading="lazy"
               alt="Grove's Browser tab with pinned Vite and React documentation sites open as tabs beside the workspace" />
        </a>
        <p class="screenshot-caption">Pin the docs, tracker, or dashboard for each project — right beside your code.</p>
      </div>
      <div class="screenshot-item">
        <a class="screenshot-frame" href="/screenshots/settings.png">
          <img src="/screenshots/settings.png" width="1040" height="900" loading="lazy"
               alt="Grove's Settings window on the General tab, showing Markdown preview options and accent color choices" />
        </a>
        <p class="screenshot-caption">Sensible defaults out of the box — and an accent color that's yours.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHY -->
<section class="section why">
  <div class="section-inner">
    <div class="why-inner">
      <div class="why-text">
        <p class="eyebrow">Why native?</p>
        <h2>Built for macOS.<br>Not ported to it.</h2>
        <ul class="why-list">
          <li>
            <span class="check">✓</span>
            <span>Built to never freeze on you — no spinning beachballs, even with several agents running at once.</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>Feels like part of macOS, not a webpage in a window — matches your Dark Mode, your font size, your system, right out of the box.</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>Install with confidence — Apple has verified Grove is safe, so you won't hit a scary "unidentified developer" warning, even outside the App Store.</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>Finds your tools wherever you installed them — Homebrew, <code>~/.local/bin</code>, <code>~/.bun/bin</code> — even when you launch Grove from the Dock, not a terminal.</span>
          </li>
        </ul>
      </div>
      <div class="why-visual">
        <div class="badge-stack">
          <div class="badge">Swift 6.2</div>
          <div class="badge">SwiftUI</div>
          <div class="badge">macOS 26+</div>
          <div class="badge">Developer ID</div>
          <div class="badge">No Electron</div>
          <div class="badge">No subscriptions</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AGENTS -->
<section class="section agents">
  <div class="section-inner">
    <p class="eyebrow">Supported agents</p>
    <h2>Choose your AI coding partner.</h2>
    <p class="section-sub">Grove finds the agent binary automatically — no PATH configuration required. Using something else? Add any CLI agent in Settings.</p>
    <div class="agent-row">
      <div class="agent-pill">Claude Code</div>
      <div class="agent-pill">opencode</div>
      <div class="agent-pill">Codex CLI</div>
      <div class="agent-pill">Gemini CLI</div>
      <div class="agent-pill">Aider</div>
    </div>
  </div>
</section>

<!-- PRICING -->
<section class="section pricing" id="pricing">
  <div class="section-inner">
    <p class="eyebrow">Pricing</p>
    <h2>Pay once, own it forever.</h2>
    <p class="section-sub">One-time purchase. Every future update included. Pick the seat count that fits how many Macs you use.</p>

    <div class="pricing-grid">

      <article class="pricing-card">
        <span class="pricing-name">1 License</span>
        <div class="pricing-amount">
          <span class="pricing-currency">$</span>
          <span class="pricing-price">9.99</span>
        </div>
        <span class="pricing-period">one-time · 1 Mac</span>

        <ul class="pricing-features">
          <li><span class="check">✓</span> All current features</li>
          <li><span class="check">✓</span> All future updates</li>
          <li><span class="check">✓</span> Unlimited workspaces &amp; worktrees</li>
          <li><span class="check">✓</span> All AI agents — Claude Code, opencode, Codex, Gemini CLI, Aider, or your own</li>
          <li><span class="check">✓</span> macOS 26+ · Developer ID signed &amp; notarized</li>
        </ul>

        <a href="https://molayab.gumroad.com/l/grove"
           data-gumroad-overlay-checkout="true"
           role="button" class="btn pricing-btn">Buy License</a>
      </article>

      <article class="pricing-card pricing-featured">
        <span class="pricing-badge">Most popular</span>
        <span class="pricing-name">3 Licenses</span>
        <div class="pricing-amount">
          <span class="pricing-currency">$</span>
          <span class="pricing-price">24.99</span>
        </div>
        <span class="pricing-period">one-time · up to 3 Macs</span>

        <ul class="pricing-features">
          <li><span class="check">✓</span> All current features</li>
          <li><span class="check">✓</span> All future updates</li>
          <li><span class="check">✓</span> Unlimited workspaces &amp; worktrees</li>
          <li><span class="check">✓</span> All AI agents — Claude Code, opencode, Codex, Gemini CLI, Aider, or your own</li>
          <li><span class="check">✓</span> macOS 26+ · Developer ID signed &amp; notarized</li>
        </ul>

        <a href="https://molayab.gumroad.com/l/grove-3"
           data-gumroad-overlay-checkout="true"
           role="button" class="btn pricing-btn">Buy License</a>
      </article>

      <article class="pricing-card">
        <span class="pricing-name">5 Licenses</span>
        <div class="pricing-amount">
          <span class="pricing-currency">$</span>
          <span class="pricing-price">39.99</span>
        </div>
        <span class="pricing-period">one-time · up to 5 Macs</span>

        <ul class="pricing-features">
          <li><span class="check">✓</span> All current features</li>

---
import '../styles/index.css';
import { SITE, findPage, type Lang } from '../data/pages';
import { ui } from '../i18n';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page, e.g. `/refund-policy.html` — becomes the canonical URL. */
  path: string;
  navVariant: 'home' | 'page' | 'legal';
  ogType?: 'website' | 'article';
  ogImageAlt?: string;
  /** schema.org JSON-LD for the page. */
  jsonLd?: object;
}
const { lang, title, description, path, navVariant, ogType = 'website', ogImageAlt = 'Grove for Mac', jsonLd } = Astro.props;

const abs = (p: string) => SITE + p;
const entry = findPage(path);
const hasAlternates = Boolean(entry?.es);
const locales = { en: 'en_US', es: 'es_ES' } as const;
const other: Lang = lang === 'en' ? 'es' : 'en';
const ogImage = abs('/og-image.png');
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={abs(path)} />
  <meta property="og:site_name" content="Grove for Mac" />
  <meta property="og:locale" content={locales[lang]} />
  {hasAlternates && <meta property="og:locale:alternate" content={locales[other]} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={abs(path)} />
  {hasAlternates && entry && (
    <>
      <link rel="alternate" hreflang="en" href={abs(entry.en)} />
      <link rel="alternate" hreflang="es" href={abs(entry.es!)} />
      <link rel="alternate" hreflang="x-default" href={abs(entry.en)} />
    </>
  )}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- Cloudflare Web Analytics -->
  <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "a675791a599947a0b2e0495e4e436ee0"}'></script>
  <script is:inline src="https://gumroad.com/js/gumroad.js"></script>
  {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      function saved() {
        try {
          var v = localStorage.getItem('grove-theme');
          return v === 'light' || v === 'dark' ? v : null;
        } catch (e) { return null; }
      }
      function apply() {
        var s = saved();
        root.setAttribute('data-theme', s || (mq.matches ? 'dark' : 'light'));
      }
      apply();
      // Follow OS theme changes only while the visitor has not picked Light or Dark.
      mq.addEventListener('change', function () { if (!saved()) apply(); });
    })();
  </script>
</head>
<body>

<Nav lang={lang} variant={navVariant} path={path} />

<main>
  <slot />
</main>

<CookieBanner lang={lang} />
<Footer lang={lang} />

<script>
  import { initConsent } from '../scripts/consent.js';
  initConsent();
</script>
</body>
</html>
